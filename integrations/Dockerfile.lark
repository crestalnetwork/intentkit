FROM golang:1.26-alpine AS builder
WORKDIR /app
RUN apk add --no-cache git
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o intent-lark ./cmd/lark

FROM alpine:latest
ARG RELEASE=local
ENV RELEASE=${RELEASE}
WORKDIR /app
RUN apk --no-cache add ca-certificates tzdata
COPY --from=builder /app/intent-lark .
# Public Lark event-subscription webhook + OAuth callback (behind ingress / TLS).
ENV LARK_LISTEN_ADDR=:8084
EXPOSE 8084
CMD ["./intent-lark"]
